# Copy to .env.local (never commit it) and fill in from Supabase: Project Settings > API.
# The anon (publishable) key is meant for browsers; row-level security protects the data.
# NEVER put the service_role key here or anywhere in the client.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Online game server (phase 6), for example wss://<app>.fly.dev or ws://localhost:8080 while developing.
VITE_GAME_SERVER_URL=
