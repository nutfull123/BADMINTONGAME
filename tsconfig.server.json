{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022"],
    "strict": true,
    "noUnusedLocals": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["node"]
  },
  "include": [
    "server",
    "src/types.ts",
    "src/net",
    "src/rules",
    "src/physics",
    "src/sim",
    "src/game/rally.ts",
    "src/ui/model.ts"
  ],
  "exclude": ["src/**/*.test.ts"]
}
